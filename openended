    {
      "cell_type": "markdown",
      "source": [
        "## 7. Decision Tree\n"
      ],
      "metadata": {
        "id": "UD04NgXC8CmU"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "dt_model = DecisionTreeClassifier(random_state=42)\n",
        "dt_model.fit(X_train_scaled, y_train)\n",
